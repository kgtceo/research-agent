# Copy to .env and fill in. Never commit your real key.
ANTHROPIC_API_KEY=sk-ant-...

# Web search defaults to DuckDuckGo (no key). Optional overrides:
# AGENT_MODEL=claude-sonnet-4-6
# AGENT_JUDGE_MODEL=claude-opus-4-8
# AGENT_MAX_STEPS=8
# API only: comma-separated allowed web origins (prod). Localhost always allowed.
# AGENT_CORS_ORIGINS=https://agent.kareemghazal.com
